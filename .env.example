# Origin of the Theiavora Express API (no trailing slash, no /api suffix).
# The frontend calls e.g. ${NEXT_PUBLIC_API_URL}/api/tasks
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional display name
NEXT_PUBLIC_APP_NAME=Theiavora

# DEVELOPMENT ONLY: skip login and use a local preview user (role switcher in
# the top banner). Ignored by production builds. `npm run dev:preview` sets this
# for you together with the mock API.
# NEXT_PUBLIC_AUTH_DISABLED=true
# Optional: act as this user id (e.g. a seed user) so "my tasks" actions apply.
# NEXT_PUBLIC_PREVIEW_USER_ID=
